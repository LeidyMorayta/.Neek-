# Este archivo se incluye dentro del bloque "http" del nginx.conf de Ubuntu.
# Límite básico contra ráfagas de solicitudes a un análisis costoso.
limit_req_zone $binary_remote_addr zone=fieldshift_analisis:10m rate=1r/s;

server {
    listen 80;
    server_name api.TUDOMINIO.com;
    client_max_body_size 1m;

    location = /analizar {
        limit_req zone=fieldshift_analisis burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 90s;
    }

    # Una parcela exige hasta cuatro peticiones de SoilGrids WCS; se aplica
    # limitación de tasa y un timeout explícito para consultas frías.
    location = /analizar-parcela {
        limit_req zone=fieldshift_analisis burst=2 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 340s;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }
}
