# Copiar manualmente a /etc/fieldshift/fieldshift.env, fuera del ZIP del proyecto.
# Reemplaza TUDOMINIO.com con el dominio real de Porkbun.
FIELDSHIFT_ALLOWED_ORIGINS=https://TUDOMINIO.com,https://www.TUDOMINIO.com
# Opcional, SOLO si se usan credenciales válidas de Meteomatics para la descarga:
# METEOMATICS_USERNAME=usuario
# METEOMATICS_PASSWORD=contrasena
