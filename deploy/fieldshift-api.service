[Unit]
Description=FieldShift API (FastAPI + Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fieldshift
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/fieldshift/fieldshift.env
ExecStart=/home/ubuntu/miniforge3/envs/fieldshift/bin/python -m uvicorn api:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
